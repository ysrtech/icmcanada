<?xml version="1.0"?>

<layout>
    <!-- Orders -->
	<adminhtml_sales_order_view>
		<reference name="order_tab_info">
			<action method="setTemplate" ifconfig="deliverynote_options/basic_settings/plug_and_play">
				<template>deliverynote/sales/order/view/tab/info.phtml</template>
			</action>
			<block type="deliverynote/adminhtml_sales_order_note" name="deliverynote" template="deliverynote/note.phtml" />
		</reference>
	</adminhtml_sales_order_view>
         <adminhtml_sales_order_index>
            <update handle="deliverynote_extra_columns" />
        </adminhtml_sales_order_index>
        <adminhtml_sales_order_grid>
            <update handle="deliverynote_extra_columns" />
        </adminhtml_sales_order_grid>
         <deliverynote_extra_columns>
            <reference name="sales_order.grid">
                <action method="addColumnAfter">
                    <columnId>deliverynote</columnId>
                    <arguments module="deliverynote" translate="header">
                        <header>Delivery Note</header>
                        <renderer>Dh_Deliverynote_Block_Adminhtml_Widget_Grid_Column_Renderer_DeliveryNote</renderer>
                        <type>text</type>
                        <sortable>false</sortable>
                        <filter>Dh_Deliverynote_Block_Adminhtml_Widget_Grid_Column_Renderer_DeliveryNote</filter>
                    </arguments>
                    <after>entity_id</after>
                </action>
                
            </reference>
        </deliverynote_extra_columns>

	<!-- Invoices -->
	<adminhtml_sales_order_invoice_new>
		<reference name='form'>
			<action method="setTemplate" ifconfig="deliverynote_options/basic_settings/plug_and_play">
				<template>deliverynote/sales/order/invoice/create/form.phtml</template>
			</action>
			<block type="deliverynote/adminhtml_sales_order_note" name="deliverynote" template="deliverynote/note.phtml" />
		</reference>
	</adminhtml_sales_order_invoice_new>
	<adminhtml_sales_order_invoice_view>
		<reference name='form'>
			<action method="setTemplate" ifconfig="deliverynote_options/basic_settings/plug_and_play">
				<template>deliverynote/sales/order/invoice/view/form.phtml</template>
			</action>
			<block type="deliverynote/adminhtml_sales_order_note" name="deliverynote" template="deliverynote/note.phtml" />
		</reference>
	</adminhtml_sales_order_invoice_view>
	
	<!-- Shipments -->
	<adminhtml_sales_order_shipment_new>
		<reference name='form'>
			<action method="setTemplate" ifconfig="deliverynote_options/basic_settings/plug_and_play">
				<template>deliverynote/sales/order/shipment/create/form.phtml</template>
			</action>
			<block type="deliverynote/adminhtml_sales_order_note"
				name="deliverynote" template="deliverynote/note.phtml"></block>
		</reference>
	</adminhtml_sales_order_shipment_new>
	<adminhtml_sales_order_shipment_view>
		<reference name='form'>
			<action method="setTemplate" ifconfig="deliverynote_options/basic_settings/plug_and_play">
				<template>deliverynote/sales/order/shipment/view/form.phtml</template>
			</action>
			<block type="deliverynote/adminhtml_sales_order_note"
				name="deliverynote" template="deliverynote/note.phtml"></block>
		</reference>
	</adminhtml_sales_order_shipment_view>
	
	<!-- Credt Memos -->
	<adminhtml_sales_order_creditmemo_new>
		<reference name='form'>
			<action method="setTemplate" ifconfig="deliverynote_options/basic_settings/plug_and_play">
				<template>deliverynote/sales/order/creditmemo/create/form.phtml</template>
			</action>
			<block type="deliverynote/adminhtml_sales_order_note"
				name="deliverynote" template="deliverynote/note.phtml"></block>
		</reference>
	</adminhtml_sales_order_creditmemo_new>
	<adminhtml_sales_order_creditmemo_view>
		<reference name='form'>
			<action method="setTemplate" ifconfig="deliverynote_options/basic_settings/plug_and_play">
				<template>deliverynote/sales/order/creditmemo/view/form.phtml</template>
			</action>
			<block type="deliverynote/adminhtml_sales_order_note"
				name="deliverynote" template="deliverynote/note.phtml"></block>
		</reference>
	</adminhtml_sales_order_creditmemo_view>
</layout>