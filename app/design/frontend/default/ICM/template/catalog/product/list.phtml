<?php
/**
 * Product list template
 *
 * @see Mage_Catalog_Block_Product_List
 */
?>
<?php
if (Mage::registry('current_category')){
$currentCategory = Mage::registry('current_category');

    $allCategories = Mage::getModel('catalog/category');
    $CategoriesTree = $allCategories->getTreeModel()->load();
    $categoriesIds = $CategoriesTree->getCollection()->getAllIds();
    $categoryChild = array();

    if ($categoriesIds) {
        foreach ($categoriesIds as $categoryId){
            $category = Mage::getModel('catalog/category')->load($categoryId);
            if ($category->parent_id == $currentCategory->entity_id) {
                $categoryChild = $category;
            }
        }
    }
}
?>
<?php $_productCollection=$this->getLoadedProductCollection();?>

<?php if(!$_productCollection->count() && empty($categoryChild)): ?>
<p class="note-msg">
    <?php echo $this->__('Products coming soon!') ?>
</p>
<?php else: ?>
<div class="category-products">
    <?php echo $this->getToolbarHtml() ?>
    <ul class="products-grid largeview">
    <?php foreach ($_productCollection as $_product):?>
            <li class="item">
                <a href="<?php echo $_product->getProductUrl() ?>" title="<?php echo $this->escapeHtml($this->getImageLabel($_product, 'small_image')) ?>" class="product-image">
                <img src="<?php echo $this->helper('catalog/image')->init($_product, 'small_image')->constrainOnly(TRUE)->keepAspectRatio(TRUE)->keepFrame(TRUE)->resize(200,200)->setQuality(100); ?>" width="200" height="200"
                alt="<?php echo $this->escapeHtml($this->getImageLabel($_product, 'small_image')) ?>" /></a>
                <div class="product-name"><a href="<?php echo $_product->getProductUrl() ?>"
                title="<?php echo $this->escapeHtml($_product->getName()) ?>"><?php echo $this->escapeHtml($_product->getName()) ?></a></div>
                <?php if(Mage::getStoreConfig("catalog/frontend/hidepriceforguest") != 1 || Mage::getSingleton('customer/session')->isLoggedIn()):?>
                <?php echo $this->getPriceHtml($_product, false) ?>
                <?php endif; ?>
            </li>
        <?php endforeach ?>
        </ul>
    <?php echo $this->getToolbarHtml() ?>
</div>
<?php endif; ?>
