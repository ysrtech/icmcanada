/**
 * Product media data template
 *
 * @see Mage_Catalog_Block_Product_View_Media
 */
?>
<?php
$_product = $this->getProduct();
$_helper = $this->helper('catalog/output');
?>
<?php if ($_product->getImage() != 'no_selection' && $_product->getImage()): ?>
    <script type="text/javascript">
        jQuery(document).ready(function($){
            $().piroBox_ext({
                piro_speed : 700,
                bg_alpha : 0.5,
                piro_scroll : true // pirobox always positioned at the center of the page
            });
        });
    </script>
    <?php
    $imageurl = $this->helper('catalog/image')->init($_product, 'image')->resize(600);
    $imagelabel = $this->escapeHtml($this->getImageLabel());
    ?>
    <a  rel="gallery"  class="pirobox_gall" href="<?php echo $imageurl; ?>" title="">
        <p class="product-image product-image-zoom ">
            <img id="image" src="<?php echo $this->helper('catalog/image')->init($_product, 'image')->resize(360); ?>" width="360" height="360" alt="<?php echo $imagelabel; ?>" title="<?php echo $imagelabel ?>" />   
        </p>
        <p class="zoom-notice"><img src="<?php echo $this->getSkinUrl(); ?>images/zoom.gif" style="margin-right: 5px"/><?php echo $this->__('Click on image to view full picture') ?></p>
    </a>
<?php else: ?>
    <p class="product-image">
        <?php
        $_img = '<img src="' . $this->helper('catalog/image')->init($_product, 'image')->resize(360) . '" alt="' . $this->escapeHtml($this->getImageLabel()) . '"  width="360" height="360" title="' . $this->escapeHtml($this->getImageLabel()) . '" />';
        echo $_helper->productAttribute($_product, $_img, 'image');
        ?>
    </p>
<?php endif; ?>

<?php if (count($this->getGalleryImages()) > 0): ?>
    <div class="more-views">
        <h2><?php echo $this->__('More Images') ?></h2>
        <ul>
            <?php foreach ($this->getGalleryImages() as $_image): ?>
                <li>
                    <a rel="gallery" title="" class="pirobox_gall" href="<?php echo $this->helper('catalog/image')->init($this->getProduct(), 'thumbnail', $_image->getFile())->resize(600); ?>">
                        <img src="<?php echo $this->helper('catalog/image')->init($this->getProduct(), 'thumbnail', $_image->getFile())->resize(66); ?>" width="66" height="66" alt="<?php echo $this->escapeHtml($_image->getLabel()) ?>" />
                    </a>
                </li>
            <?php endforeach; ?>
        </ul>
    </div>

<?php endif; ?>
<?php echo $this->getChildHtml('product_attachments') ?>
