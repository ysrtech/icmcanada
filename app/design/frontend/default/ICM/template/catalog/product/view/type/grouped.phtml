/**
 * Grouped product data template
 *
 * @see Mage_Catalog_Block_Product_View_Media
 * @see Mage_Catalog_Block_Product_View_Type_Grouped
 */
?>
<?php $_product = $this->getProduct() ?>
<?php $_associatedProducts = $this->getAssociatedProducts() ?>
<div class="group-items" id="grouped-items">
    <div class="group-items-head"><?php echo $this->__('Items') ?> <a class="back-top" href="#top">Back to top <span class="arrow-up"></span></a></div>
<div class="group-items-content">
<ol class="grouped-items-list" id="super-product-list">
    <?php if (count($_associatedProducts)): ?>
   
    <?php foreach ($_associatedProducts as $_item): ?>
        <?php $_finalPriceInclTax = $this->helper('tax')->getPrice($_item, $_item->getFinalPrice(), true) ?>
        <li class="group-item">
            <div class="item-basics" >
                <p class="item-name" ><?php echo $this->htmlEscape($_item->getName()) ?></p>
                <p class="sku" >SKU: <?php echo $_item->getData('sku')?></p>
                <p class="item-link" ><a href="<?php echo $_item->getProductUrl()?>">More details >></a></p>
            </div>
            <div class="item-image" >
                <?php if ($_item->getImage() != 'no_selection' && $_item->getImage()): ?>
                <a rel="gallery" class="pirobox_gall" href="<?php echo $this->helper('catalog/image')->init($_item, 'image')->resize(600); ?>" title="">
                <img width="80" class="thumbnail" src="<?php echo $this->helper('catalog/image')->init($_item, 'image')->resize(80); ?>" title="<?php echo $this->htmlEscape($_item->getName()) ?>"/>
                <p class="zoom-notice"><img src="<?php echo $this->getSkinUrl(); ?>images/zoom.gif" style="margin-right: 5px"/><?php echo $this->__('Zoom') ?></p>
                </a>
                <?php else: ?>
                    <img width="80" class="thumbnail" src="<?php echo $this->helper('catalog/image')->init($_item, 'image')->resize(80); ?>" title="<?php echo $this->htmlEscape($_item->getName()) ?>"/>
                <?php endif;?>
            </div>
            <?php if(Mage::getStoreConfig("catalog/frontend/hidepriceforguest") != 1 || Mage::getSingleton('customer/session')->isLoggedIn()):?>
            <div class="item-price">
                <?php echo $this->getPriceHtml($_item, true) ?>
            </div>
            <div class="item-pricing">
                    <?php if ($_item->getData('msrp')):?>
                             <p class="msrp"><b>MSRP: </b><?php echo Mage::helper('core')->currency($_item->getData('msrp')) ?></p>
                    <?php endif;?>
                    <?php $_tierPrices = $this->getTierPrices($_item);?>
                    <?php if (count($_tierPrices) > 0): ?>
                        <div class="tier-pricing">
                        <p class="tier-head"><?php echo $this->__('Quantity Discount/s')?></p>
                        <?php foreach ($_tierPrices as $_price): ?>
                             <p class="master-price"><?php echo $this->__('Buy ') ?><?php echo $_price['price_qty'] ?> for <b><?php echo $_price['formated_price'] ?></b>
                              <?php if(($_item->getPrice() == $_item->getFinalPrice() && $_item->getPrice() > $_price['price'])
                                || ($_item->getPrice() != $_item->getFinalPrice() &&  $_item->getFinalPrice() > $_price['price'])): ?>
                                        <?php $price_per_item = $_price['price'] / $_price['price_qty'];?>
                                 <?php echo $this->__('each and ')?>
                                     <b><i><?php echo $this->__('save')?>&nbsp;<?php echo $_price['savePercent']?>%</i></b>
                              <?php endif ?>
                             </p>
                             <p class="per-carton"><b><?php echo $this->__('Qty in Master Carton') ?>:</b> <?php echo $_price['price_qty'] ?></p>
                        <?php endforeach ?>
                        </div>
                    <?php endif;?>
            </div>
            <div class="qty">
            <?php if ($_product->isSaleable()): ?>
            <?php if ($_item->isSaleable()) : ?>
               Quantity&nbsp;<input type="text" name="super_group[<?php echo $_item->getId() ?>]" maxlength="12" value="<?php echo $_item->getQty()*1 ?>" title="<?php echo $this->__('Qty') ?>" class="input-text qty" />
            <?php else: ?>
                <p class="availability out-of-stock"><span><?php echo $this->__('Out of stock') ?></span></p>
            <?php endif; ?>
            <?php endif; ?>
            </div>
            <div class="add-to-button">
            <?php if ($_item->isSaleable()) : ?>
                <button type="button" title="<?php echo $this->__('Add to Cart') ?>" class="button btn-cart" onclick="productAddToCartForm.submit()">
                    <span><span><?php echo $this->__('Add to Cart') ?></span></span>
                </button>
            <?php endif; ?>
            </div>
         <?php else: ?>
         <div class="please-login">Please <a href="<?php echo $this->getBaseUrl()?>customer/account/login/">log in</a> to view pricing and to order online.</div>
         <?php endif;?>
        </li>
    <?php endforeach; ?>
    <?php else: ?>
       <li>
           <div colspan="<?php if ($_product->isSaleable()): ?>4<?php else : ?>3<?php endif; ?>"><?php echo $this->__('No options of this product are available.') ?></div>
       </li>
    <?php endif; ?>
    </ol>
<script type="text/javascript">decorateTable('super-product-list')</script>
</div>
</div>
