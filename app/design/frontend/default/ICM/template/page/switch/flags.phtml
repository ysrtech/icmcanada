<?php if(count($this->getStores())>1): ?>
<div class="form-language">
    <?php echo $this->__('Language:') ?>
    <img width="13px" alt="<?php echo Mage::app()->getStore()->getName()?>" src="<?php echo $this->getSkinUrl('images/flag_'.$this->getCurrentStoreCode().'.png') ?>">
    <a id="langDropdown" href="#"><?php echo Mage::app()->getStore()->getName()?><span class="arrow-down"></span></a>
    <ul><?php foreach ($this->getStores() as $_lang): ?>
        <?php $_selected = ($_lang->getId() == $this->getCurrentStoreId()) ? 'selected' : '' ?>
		<li>
        <a class="<?php echo $_selected ?>" onclick="document.location.href='<?php echo $_lang->getCurrentUrl() ?>'" href="<?php echo $_lang->getCurrentUrl() ?>">
        <img width="13px" src="<?php echo $this->getSkinUrl('images/flag_'.$_lang->getCode().'.png') ?>" alt="<?php echo $this->escapeHtml($_lang->getName()) ?>"><?php echo $this->escapeHtml($_lang->getName()) ?></a>
        </li><?php endforeach; ?>
	</ul>
</div>
<?php endif; ?>
