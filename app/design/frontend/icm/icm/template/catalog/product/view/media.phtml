/**
 * Product media data template
 *
 * @see Mage_Catalog_Block_Product_View_Media
 */
?>
<?php
    $_product = $this->getProduct();
    $_helper = $this->helper('catalog/output');


$data = Mage::getModel('fileuploader/fileuploader')->getFilesByProductId($_product->getId());

$totalFiles = $data['totalRecords'];

if ($totalFiles > 0) {

        
    $attachments = array();
$inline_attachments = array();

$v_helper = Mage::helper('fileuploader');
    $record = $data['items'];

    $i = 0;
    foreach ($record as $rec) {

        $i++;
        if ($rec['content_disp'] == 1) {
             $inline_attachments[] = array('title' => $rec['title'], 'url' => $rec['uploaded_file'], 'thumbnail' => $rec['thumbnail']);
        } else {
            $file = $_helper->getFilesHtml($rec['uploaded_file'], $rec['title'], $i, true, $rec['content_disp'], true);
            $attachments[] = array('title' => $rec['title'], 'file' => $file, 'content' => $rec['file_content']);
        }
    }
}
?>
<?php if (!empty($inline_attachments)): ?>
     <div class="videos-window" style="display: none">
<script type="text/javascript" src="<?php echo Mage::getBaseUrl(Mage_Core_Model_Store::URL_TYPE_JS);?>jwplayer/jwplayer.js"></script> 
    
    <?php 
    $vid_thumbs = array(); 
    $a = 0; foreach ($inline_attachments as $inline_attachment): $a++; 
        if ($inline_attachment['thumbnail']) {
            $thumbnail = str_replace('custom/upload/','',$inline_attachment["thumbnail"]);
              $_imageUrl = Mage::getBaseDir('media').DS."custom".DS."upload".DS.$thumbnail;
              $imageResized = Mage::getBaseDir('media').DS."custom".DS."upload".DS."resizedbig".DS.$thumbnail;
                                    if (!file_exists($imageResized)&&file_exists($_imageUrl)){
                                        $imageObj = new Varien_Image($_imageUrl);
                                        $imageObj->constrainOnly(TRUE);
                                        $imageObj->backgroundColor(array(85,85,85));
                                        $imageObj->keepAspectRatio(TRUE);
                                        $imageObj->keepFrame(TRUE);
                                        $imageObj->resize(556);
                                        $imageObj->quality(100);
                                        $imageObj->save($imageResized);
                                    }
              $newimage = Mage::getBaseUrl('media')."custom/upload/resizedbig/".$thumbnail;
              } else {
                $newimage = $this->helper('catalog/image')->init($_product, 'image')->resize(556);
                 }
             
             $vid_thumbs[$a] =   $newimage; 
                 
    ?>

                <div id="container_<?php echo $a?>" style="border:5px solid #efefef;">Loading the player ...</div> 
 
                    <script type="text/javascript"> 
                        jwplayer("container_<?php echo $a?>").setup({ 
                            autostart: false, 
                            file: "<?php echo Mage::getBaseUrl(Mage_Core_Model_Store::URL_TYPE_MEDIA).$inline_attachment['url']; ?>", 
                            //flashplayer: "<?php echo Mage::getBaseUrl(Mage_Core_Model_Store::URL_TYPE_JS);?>/jwplayer/dangdang.swf", 
                            volume: 80, 
                            width: "100%",
                            aspectratio: "19:9",
                            image: "<?php echo $newimage; ?>",
                            modes: [ 
                                { type: "html5" }, 
                                { type: "flash", src: "<?php echo Mage::getBaseUrl(Mage_Core_Model_Store::URL_TYPE_JS);?>/jwplayer/player.swf" }, 
                                { type: "download" } 
                            ],
                            screencolor: 'fff',
                            title: "<?php echo $inline_attachment['title']; ?>"
                        }); 
                    </script> 
    <?php endforeach; ?>
</div>
        <?php endif; ?>
<?php if ($_product->getImage() != 'no_selection' && $_product->getImage()): ?>
<div class="product-image product-image-zoom">
     <img id="zoom"
                 src="<?php echo $image = $this->helper('catalog/image')->init($_product, 'image')->constrainOnly(TRUE)->resize(575); ?>"
                 data-zoom-image="<?php echo $full_image = $this->helper('catalog/image')->init($_product, 'image')->constrainOnly(TRUE)->resize(1000); ?>"
                 />
         
     
</div>

<?php else: ?>
<div class="product-image">
    <?php
        $_img = '<img src="'.$this->helper('catalog/image')->init($_product, 'image')->resize(575).'" alt="'.$this->escapeHtml($this->getImageLabel()).'" '
                . 'title="'.$this->escapeHtml($this->getImageLabel()).'" />';
        echo $_helper->productAttribute($_product, $_img, 'image');
    ?>
</div>
<?php endif; ?>
<?php if (count($this->getGalleryImages()) > 0):?>
<div class="more-views" id="gall">
    <div class="more-item">
        <a href="#" data-image="<?php echo $image; ?>" data-zoom-image="<?php echo $full_image; ?>" class="image-thumb">
                <img id="image-0" src="<?php echo $this->helper('catalog/image')->init($_product, 'image')->constrainOnly(TRUE)->resize(90); ?>" />
        </a>
    </div>
             
    <?php $t = 1;
    foreach ($this->getGalleryImages() as $_image): ?>
        <?php if ($this->isGalleryImageVisible($_image)): ?>
    <div class="more-item">
    <a  href="#" class="image-thumb"
                                data-image="<?php echo $this->helper('catalog/image')->init($this->getProduct(), 'thumbnail', $_image->getFile())->constrainOnly(TRUE)->resize(575); ?>" 
                                data-zoom-image="<?php echo $this->helper('catalog/image')->init($this->getProduct(), 'thumbnail', $_image->getFile())->constrainOnly(TRUE)->resize(1000); ?>">
                                <img id="image-<?php echo $t; ?>" src="<?php echo $this->helper('catalog/image')->init($this->getProduct(), 'thumbnail', $_image->getFile())->constrainOnly(TRUE)->resize(90); ?>"/>
                            </a>
        </div>
            <?php endif; ?>
            <?php $t++;
        endforeach; ?>
<?php if (!empty($vid_thumbs)): ?>

    <?php foreach ($vid_thumbs as $k => $vid_thumb): ?>
    <div class="more-item">
            <a  href="#" class="vid-thumb">
                <div class="thumb-play-button"></div>
                <img id="vid-<?php echo $k; ?>" src="<?php echo $vid_thumb; ?>"/>
            </a>
    </div>
    <?php $t++; endforeach; ?>
    <?php endif; ?>
</div>





       
<?php endif; ?>
 <script type="text/javascript">
    jQuery(document).ready(function ($) {

    $('#zoom').ezPlus({
        constrainType: 'width', 
        zoomType: 'inner',
        containLensZoom: true, 
        gallery: 'gall', 
        cursor: 'pointer', 
        galleryActiveClass: 'active',
        zoomWindowFadeIn: 500,
        zoomWindowFadeOut: 500,
        lensFadeIn: 500,
        lensFadeOut: 500,
        easing: true,
        zIndex:10
    });

    //pass the images to Fancybox
    $('#zoom').bind('click', function (e) {
        var ez = $('#zoom').data('ezPlus');
        $.fancyboxPlus(ez.getGalleryList());
        return false;
    });      
   
    
    $('.thumb-play-button').click(function(e){
        e.preventDefault();
         var imagesBox = $('.product-image-zoom');
         statHeight = imagesBox.height();
         imagesBox.hide();
         $('.videos-window').css('height',statHeight)
         $('.videos-window').show();
    });
    
    $('.image-thumb img').click(function(e){
        e.preventDefault();
        $('.videos-window').hide();
        $('.product-image-zoom').show();
         
    });
     });
    </script>

