 <script type="text/javascript">
          function qtyDown(qty_id){
                                        var qty_el = jQuery('#qty_'+qty_id);
                                        var qty = parseInt(qty_el.val());
                                        var qty_inc = 1;
                                        var qty_min = 1;
                                         if( qty == 1) {
                                             return false;
                                         }
                                         if( !isNaN( qty ) && qty > 0 ){
                                             qty_el.val(((qty - qty_inc) >= qty_min) ? qty - qty_inc : qty_min );
                                         }         
                                         return false;
                                     }

                                     function qtyUp(qty_id){
                                       var qty_el = jQuery('#qty_'+qty_id);
                                        var qty = parseInt(qty_el.val());
                                        var qty_inc = 1;
                                         if( !isNaN( qty )) {
                                             qty_el.val(qty + qty_inc);
                                         }
                                         return false;
                                     }

        </script>

