<?php 
$filter = new Mage_Widget_Model_Template_Filter();

?>


<?php if ($this->hasValidGroup()): ?>
    <?php $group = $this->getGroup() ?>
    <?php $banners = $this->getBanners() ?>
    <?php if ($this->getGroup()->getBannerCount() > 0): ?>
            <div class="body-bottom-banners <?php echo $this->getWrapperClass() ?>" id="<?php echo $this->getWrapperId() ?>">
                <?php foreach ($banners as $banner): ?>
                <div class="banner <?php if (!$banner->getHtml()): ?>image-only<?php endif; ?>">
                    <?php if ($banner->hasUrl()): ?>
                        <a href="<?php echo $banner->getUrl() ?>" title="<?php echo $this->escapeHtml($banner->getTitle()) ?>">
                        <?php endif; ?>
                            
                        <?php if ($banner->getImageUrl()): ?>
                            <img src="<?php echo $banner->getImageUrl() ?>" alt="<?php echo $this->escapeHtml($banner->getAltText()) ?>" />
                        <?php endif; ?>
                        <?php if ($banner->getHtml()): ?>
                            <?php echo $filter->filter($banner->getHtml()) ?>
                        <?php endif; ?>
                            
                        <?php if ($banner->hasUrl()): ?>
                        </a>
                        <?php endif; ?>
                </div>
                <?php endforeach; ?>
            </div>
    <?php endif; ?>
<?php endif; ?>