<script type="text/javascript">

jQuery("header").headroom({
  "offset": 200,
  "tolerance": 5,
  "classes": {
    "pinned": "static",
    "unpinned": "static"
  }
});


        jQuery(document).ready(function ($) {

            $(".menu-trigger, .canvas-overlay, .menu-close").click(function () {
                $(".left-canvas li").removeClass('active');
                
                $(".wrapper").toggleClass("menu-active");
                $(".left-canvas").toggleClass("active");

            });

            $(".search-trigger").click(function () {
                $(this).toggleClass("active");
                $(".canvas-row.mobile-search").toggleClass("active");
            });
            
            $(".left-canvas a.level0.has-children").click(function (e) {
                e.preventDefault();
                $(this).parent().toggleClass("active");
            });
           
            
        });


</script>