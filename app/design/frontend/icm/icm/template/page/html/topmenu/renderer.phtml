/** @var Mage_Page_Block_Html_Topmenu_Renderer $this */
/** @var Varien_Data_Tree_Node $menuTree */
/** @var string $childrenWrapClass */

$width = 253;
$height = 379;
$baseUrl = Mage::getBaseUrl();
$baseMediaUrl = Mage::getBaseDir('media');

$html = '';

$children = $menuTree->getChildren();
$parentLevel = $menuTree->getLevel();
$childLevel = is_null($parentLevel) ? 0 : $parentLevel + 1;

$counter = 1;
$childrenCount = $children->count();

$parentPositionClass = $menuTree->getPositionClass();
$itemPositionClassPrefix = $parentPositionClass ? $parentPositionClass . '-' : 'nav-';

foreach ($children as $child) {
    
    $child->setLevel($childLevel);
    $child->setIsFirst($counter == 1);
    $child->setIsLast($counter == $childrenCount);
    $child->setIsFirsActive($child->getIsFirst() && $childLevel == 1 ? ' over' :'');
    $child->setPositionClass($itemPositionClassPrefix . $counter.  $child->getIsFirsActive());

    $outermostClassCode = 'level'. $childLevel;
    $_hasChildren = ($child->hasChildren()) ? 'has-children' : '';

    $html .= '<li '. $this->_getRenderedMenuItemAttributes($child) .'>';
    
    if(strpos(strtolower($child->getName()), 'brands') !== false){
        $html .= '<a href="'.$this->getUrl('brand') .'" class="'. $outermostClassCode .' '. $_hasChildren .'">'. $this->escapeHtml($this->__($child->getName())) .'</a>';
    }else{
        $html .= '<a href="'. $child->getUrl() .'" class="'. $outermostClassCode .' '. $_hasChildren .'">'. $this->escapeHtml($this->__($child->getName())) .'</a>';
    }
    /*if (!empty($childrenWrapClass)) {
        $html .= '<div class="'. $childrenWrapClass .'">';
    }*/
    
    

    $nextChildLevel = $childLevel + 1;

    if (!empty($_hasChildren)) {
        $html .= '<ul class="level'. $childLevel .' '.($child->getIsFirst() && $childLevel == 1 ? ' shown-sub' :'').'">';
        $html .=     $this->render($child, $childrenWrapClass);
        $html .=     '<li class="level'. $nextChildLevel .' view-all">';
        $html .=         '<a class="level'. $nextChildLevel .'" href="'. $child->getUrl() .'">';
        $html .=             $this->__('View All') . ' ' . $this->escapeHtml($this->__($child->getName()));
        $html .=         '</a>';
        $html .=     '</li>';
        $html .= '</ul>';
    }

   /* if (!empty($childrenWrapClass)) {
        $html .= '</div>';
    }*/

    $html .= '</li>';
    
    if($childLevel == 1){
            $_catThumbnail = Mage::getModel('catalog/category')->load(substr($child->getId(), strrpos($child->getId(), '-') + 1))->getThumbnail();
            if($_catThumbnail){
                $_imageUrl= $baseMediaUrl. DS . 'catalog' . DS . 'category' . DS .$_catThumbnail;          
                $imageResized = $baseMediaUrl. DS .'catalog' . DS . 'product' . DS .'cache'. DS .$width.'x'.$height.DS.$_catThumbnail;
                    if (!file_exists($imageResized) && file_exists($_imageUrl)){
                            $imageObj = new Varien_Image($_imageUrl);
                            $imageObj->constrainOnly(TRUE);
                            $imageObj->backgroundColor(array(255,255,255));
                            $imageObj->keepAspectRatio(TRUE);
                            $imageObj->keepFrame(true);
                            $imageObj->resize($width,$height);
                            $imageObj->quality(100);
                            $imageObj->save($imageResized);
                    }
                                    
                    $html .=    '<img class="level1" src="'.$baseUrl.'media/catalog/product/cache/'.$width.'x'.$height.'/'.$_catThumbnail.'"alt="'.$child->getName().'">';
	    }/*else{
	         $html .=    '<img class="level1" src="'.$this->getSkinUrl().'images/placeholder_small.gif">';
            }*/
   }

    $counter++;
}

return $html;
