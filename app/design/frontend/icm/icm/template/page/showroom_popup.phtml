<?php
/**
 * Language switcher template
 *
 * @see Mage_Page_Block_Switch
 */
 $currentUrl = $this->helper('core/url')->getCurrentUrl();
?>
<?php if(!isset($_COOKIE['showroom']) && strpos($currentUrl, 'showroom') == false):?>

<div id="toPopup" class="popup"> 
    <div class="popup_content">
        <a class="close_popup" onclick="setCookie('showroom','shown')"><span class="ion-close-circled"></span></a> 
        <div class="message-box">
            <?php echo $this->getLayout()->createBlock('cms/block')->setBlockId('showroom_popup_message')->toHtml(); ?>
        </div>
     </div> 
</div>

<?php elseif(!isset($_COOKIE['covid'])):?>

<div id="toPopup" class="popup covid"> 
    <div class="popup_content">
        <a class="close_popup" onclick="setCookie('covid','shown')"><span class="ion-close-circled"></span></a> 
        <div class="message-box">
            <?php echo $this->getLayout()->createBlock('cms/block')->setBlockId('covid_popup_message')->toHtml(); ?>
        </div>
     </div> 
</div>
<?php endif; ?>

<script type="text/javascript">
function setCookie(name, value, expires, path, domain, secure)
{
var popup = document.getElementById("toPopup");
popup.style.display = 'none';

var cookieStr = name + "=" + escape(value) + "; ";
//if (expires) {
//    var expiresDate = new Date(new Date().getTime() + expires * 24 * 60 * 60 * 1000);
//    cookieStr += "expires=" + expiresDate.toGMTString() + "; ";
//}

var expiresDate = new Date(new Date().getTime() + 1 * 18 * 60 * 60 * 1000);
    cookieStr += "expires=" + expiresDate.toGMTString() + "; ";

cookieStr += "path=/" + "; ";

if (domain) {
    cookieStr += "domain=" + domain + "; ";
}
if (secure) {
    cookieStr += "secure; ";
}

document.cookie = cookieStr;

}
</script>

